// Outer surface for the moondsp live REPL: Strudel-style `$:` stack
// lines, ordered `+` overlays, and parenthesized groups. Dotted method
// calls (`.fast(2)`, `.jux(rev)`) bind more tightly than `+`. The mini-notation
// itself stays opaque inside String tokens — completion handles
// "we're inside a string whose enclosing call is s()" by walking the
// syntax tree and the source between cursor and the surrounding
// String node.

@top Program { (Binding | Declaration)* (DollarStack | Expression?) }

Binding { @specialize<identifier, "let"> BindingName "=" Expression ";" }
BindingName { identifier }
// The source compiler restricts declarations to bpm(number).
Declaration { Call ";" }

DollarStack { DollarLine+ }
DollarLine { "$:" Expression }

@skip { space | LineComment | BlockComment }

Expression { Chain ("+" Chain)* }
Chain { (Call | Group) MemberCall* }
Group { "(" Expression ")" }

Call       { CallName Args? }
MemberCall { "." MethodName Args? }

Args { "(" (arg ("," arg)*)? ")" }

arg { String | Number ("/" Number)? | Expression }

CallName   { identifier }
MethodName { identifier }

@tokens {
  identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }
  Number     { "-"? $[0-9]+ ("." $[0-9]+)? }
  String     { '"' (![\\\n"] | "\\" _)* '"'? }
  space      { $[ \t\n\r]+ }
  LineComment { "//" ![\n]* }
  BlockComment { "/*" (![*] | "*" ![/])* "*/" }
  @precedence { LineComment, BlockComment, "/" }
  "(" ")" "." "," "$:" "+"
}

@detectDelim
