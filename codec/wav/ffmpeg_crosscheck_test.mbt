///|
test "ffmpeg crosscheck f32_stereo" {
  let f = @wav.decode(bytes_of_hex(fixture_f32_stereo()))
  assert_true(f.channels() == 2 && f.sample_rate() == 8000)
  let s = f.samples()
  let exp = expected_f32_stereo()
  assert_true(s.length() == exp.length())
  for i = 0; i < s.length(); i = i + 1 {
    assert_true(s[i] == Float::reinterpret_from_uint(exp[i]).to_double())
  }
}

