///|
test "ffmpeg crosscheck s16_mono" {
  let f = @wav.decode(bytes_of_hex(fixture_s16_mono()))
  assert_true(f.channels() == 1 && f.sample_rate() == 8000)
  let s = f.samples()
  let exp = expected_s16_mono()
  assert_true(s.length() == exp.length())
  for i = 0; i < s.length(); i = i + 1 {
    assert_true((s[i] * 32768.0).to_int() == exp[i])
  }
}

