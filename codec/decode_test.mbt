// FLAC 交叉验证测试(自动生成,勿手改)。
// ffmpeg 将同一信号编码为 WAV 与 FLAC;decode_any 按魔数路由,
// 两条解码路径的样本必须逐位一致(FLAC 是无损编码)。

///|
fn hex_byte(v : Int) -> Byte {
  v.to_byte()
}

///|
/// 十六进制字符串 → Bytes(测试辅助)。
fn bytes_of_hex(hex : String) -> Bytes {
  let n = hex.length() / 2
  let fa : FixedArray[Byte] = FixedArray::make(n, hex_byte(0))
  for i = 0; i < n; i = i + 1 {
    let hi = hex_val(hex.get_char(i * 2).unwrap())
    let lo = hex_val(hex.get_char(i * 2 + 1).unwrap())
    fa[i] = hex_byte(hi * 16 + lo)
  }
  Bytes::from_array(fa)
}

///|
/// 十六进制字符 → 0..15。
fn hex_val(c : Char) -> Int {
  let v = c.to_int()
  if v >= 0x30 && v <= 0x39 {
    v - 0x30
  } else if v >= 0x41 && v <= 0x46 {
    v - 0x41 + 10
  } else {
    v - 0x61 + 10
  }
}

///|
/// 魔数路由失败应返回 NotAudio。
test "decode_any rejects unknown magic and short input" {
  let bad = bytes_of_hex("4F474749" + "00000000")
  match
    err_of(() => {
      let _ = @codec.decode_any(bad)
    }) {
    Some(@codec.CodecError::NotAudio(_)) => ()
    other => fail("expected NotAudio, got \{Repr(other)}")
  }
  let short = bytes_of_hex("5249")
  match
    err_of(() => {
      let _ = @codec.decode_any(short)
    }) {
    Some(@codec.CodecError::NotAudio(_)) => ()
    other => fail("expected NotAudio, got \{Repr(other)}")
  }
}

///|
fn err_of(f : () -> Unit raise @codec.CodecError) -> @codec.CodecError? {
  try {
    f()
    None
  } catch {
    error => Some(error)
  }
}

///|
fn fx_wav_mono() -> String {
  ""
}

///|
fn fx_flac_mono() -> String {
  ""
}

///|
test "decode_any: wav and flac of the same audio decode identically (mono)" {
  let wav = @codec.decode_any(bytes_of_hex(fx_wav_mono()))
  let flac = @codec.decode_any(bytes_of_hex(fx_flac_mono()))
  assert_true(wav.source_format() is @codec.SourceFormat::Wav)
  assert_true(flac.source_format() is @codec.SourceFormat::Flac)
  assert_true(wav.sample_rate() == 8000 && flac.sample_rate() == 8000)
  assert_true(wav.channels() == 1 && flac.channels() == 1)
  let sw = wav.samples()
  let sf = flac.samples()
  assert_true(sw.length() == sf.length())
  for i = 0; i < sw.length(); i = i + 1 {
    assert_true(sw[i] == sf[i])
  }
}

///|
fn fx_wav_stereo() -> String {
  ""
}

///|
fn fx_flac_stereo() -> String {
  ""
}

///|
test "decode_any: wav and flac of the same audio decode identically (stereo)" {
  let wav = @codec.decode_any(bytes_of_hex(fx_wav_stereo()))
  let flac = @codec.decode_any(bytes_of_hex(fx_flac_stereo()))
  assert_true(wav.source_format() is @codec.SourceFormat::Wav)
  assert_true(flac.source_format() is @codec.SourceFormat::Flac)
  assert_true(wav.sample_rate() == 8000 && flac.sample_rate() == 8000)
  assert_true(wav.channels() == 2 && flac.channels() == 2)
  let sw = wav.samples()
  let sf = flac.samples()
  assert_true(sw.length() == sf.length())
  for i = 0; i < sw.length(); i = i + 1 {
    assert_true(sw[i] == sf[i])
  }
}
