#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

step() {
  echo "── $1 ──"
  shift
  time "$@"
}

if [[ ! -x "$HOME/.moon/bin/moon" ]]; then
  step 'Install MoonBit' bash -c 'set -euo pipefail; curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash'
fi
export PATH="$HOME/.moon/bin:$PATH"

# Amp and supervised services start in new, non-interactive login shells.
profile_line='export PATH="$HOME/.moon/bin:$PATH" # moondsp MoonBit'
if ! grep -Fqx "$profile_line" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\n' "$profile_line" >> "$HOME/.bash_profile"
fi

step 'Refresh MoonBit registry' env NEW_MOON_MOD=0 moon update
step 'Fetch and check MoonBit dependencies' env NEW_MOON_MOD=0 moon check
step 'Install root npm dependencies' npm ci --no-audit --no-fund
step 'Install live editor npm dependencies' npm --prefix web/live ci --no-audit --no-fund
step 'Pack browser library for the synth example' env NEW_MOON_MOD=0 npm run pack:browser
# The generated tarball changes integrity with the local MoonBit toolchain;
# read the committed lockfile for registry packages without rewriting it.
step 'Install synth example npm dependencies' bash -c 'cd examples/basic-synth && npm install ../../packages/browser/moondsp-browser-0.6.0.tgz --no-save --no-audit --no-fund'

# Playwright's ZIP extractor can stall in this orb; system unzip extracts the
# same archives quickly. Each project's Playwright names its builds' install
# locations and download URLs, so they follow its version and this platform.
install_browsers() {
  local project="$1" location url archive
  shift
  while read -r location url; do
    [[ -f "$location/INSTALLATION_COMPLETE" ]] && continue
    echo "── Install Playwright $(basename "$location") ──"
    archive="$(mktemp)"
    trap 'rm -f "$archive"' EXIT
    time curl -fsSL "$url" -o "$archive"
    rm -rf "$location"
    mkdir -p "$location"
    time unzip -qo "$archive" -d "$location"
    touch "$location/INSTALLATION_COMPLETE"
    rm -f "$archive"
    trap - EXIT
  done < <(node "$project/node_modules/playwright-core/cli.js" install --dry-run "$@" |
    awk '/Install location:/ { location = $3 } /Download url:/ && !seen[location]++ { print location, $3 }')
}

# The root suites need only the headless shell; web/live also runs Firefox and
# WebKit. WebKit plays through GStreamer, which needs a PulseAudio sink
# (.agents/resume starts one) to start an AudioContext.
install_browsers . chromium-headless-shell
install_browsers web/live chromium-headless-shell firefox webkit
step 'Install WebKit audio output' sudo apt-get install -y -q --no-install-recommends \
  pulseaudio gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-pulseaudio
(cd web/live && step 'Install Firefox and WebKit system libraries' npx playwright install-deps firefox webkit)
