import {
  "dowdiness/moondsp-browser-host" @host,
  "moonbitlang/async",
  "moonbitlang/async/js_async",
}

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "engine_lifetime_wait",
        "engine_lifetime_close",
        "engine_lifetime_group_probe",
      ],
    },
  },
)
