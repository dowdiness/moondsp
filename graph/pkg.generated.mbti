pub fn StereoDspTopologyController::apply_control(Self, GraphControl) -> Result[Unit, GraphControlError]
pub fn StereoDspTopologyController::apply_controls(Self, Array[GraphControl]) -> Result[Unit, GraphControlError]
pub fn StereoDspTopologyController::from_nodes(Array[DspNode], @dsp.DspContext, crossfade_samples? : Int32) -> Self?
pub fn StereoDspTopologyController::gate_off(Self, Int32) -> Result[Unit, GraphControlError]
pub fn StereoDspTopologyController::gate_on(Self, Int32) -> Result[Unit, GraphControlError]
pub fn StereoDspTopologyController::process(Self, @dsp.DspContext, @dsp.AudioBuffer, @dsp.AudioBuffer) -> Unit
