let short = note("E4").slow(1.5).attack(0.01).hold(0.1).release(0.2);
let swell = note("E4").slow(3).attack(1).hold(1).release(3);
let drift = note("E4").slow(7).attack(2).hold(3).release(8);

song(
  section("short", 3/2, short),
  section("swell", 3, swell),
  section("drift", 7, drift),
  part("a", "short"),
  part("b", "swell"),
  part("c", "drift")
)
